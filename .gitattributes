# 统一换行符处理
* text=auto eol=lf

# Windows 专用脚本保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件
*.png binary
*.jpg binary
*.pt binary
*.pth binary
*.npz binary
*.npy binary
*.index binary
*.wav binary
*.dll binary

# 语言标注（让 GitHub 正确统计引擎代码）
*.comp linguist-language=GLSL
*.zig  linguist-language=Zig

# 文档不计入语言统计
*.md linguist-documentation

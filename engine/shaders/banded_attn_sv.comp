// Banded attention context (T5 relative-position fused): attnW [H, T, T]
// (softmaxed scores), v [T, C] head-interleaved, used[2T-1, D] relative-
// position value embedding. Computes
//   ctx[t, h*D+d] = sum_s attnW[h, t, s] * (v[s, h*D+d] + used[s-t+T-1, d])
// into out[T, C] interleaved (heads merged, transpose-back folded — same as
// attn_sv). Mathematically identical to
//   ctx = attnW@v + rel_to_abs(attnW)@used   (enc_p 相对位置 V 项)
// fused into one kernel — no [H,P,2P-1] rel_w round-trip (D5).
//
// One 16x16 workgroup per (h, t-tile, d-tile): gx=ceil(D/16), gy=ceil(T/16),
// gz=H. Inner reduction over s in 16-wide chunks with shared sW/sV tiles;
// used read per (s, d) along the diagonal (s-t) — sequential for fixed t.
#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer BW { float w[]; };       // [H, T, T]
layout(set = 0, binding = 1) readonly buffer BV { float v[]; };       // [T, C]
layout(set = 0, binding = 2) readonly buffer BU { float used[]; };    // [2T-1, D]
layout(set = 0, binding = 3) buffer BO { float out_data[]; };         // [T, C]

layout(push_constant) uniform PC {
    uint H;
    uint T;
    uint D;   // head dim (<= 128)
    uint C;   // = H * D
} pc;

shared float sW[16][16];
shared float sV[16][16];

void main() {
    const uint h   = gl_GlobalInvocationID.z;
    const uint t0  = gl_WorkGroupID.y * 16u;
    const uint d0  = gl_WorkGroupID.x * 16u;
    const uint lx  = gl_LocalInvocationID.x;
    const uint ly  = gl_LocalInvocationID.y;
    const uint tid = ly * 16u + lx;

    const uint hd = h * pc.D;
    const uint trow = t0 + ly;
    const uint dcol = d0 + lx;

    float acc = 0.0;
    for (uint s = 0u; s < pc.T; s += 16u) {
        for (uint e = tid; e < 256u; e += 256u) {
            const uint r = e >> 4u;
            const uint c = e & 15u;
            const uint tt = t0 + r;
            const uint ss = s + c;
            sW[r][c] = (tt < pc.T && ss < pc.T)
                       ? w[h * pc.T * pc.T + tt * pc.T + ss] : 0.0;
        }
        for (uint e = tid; e < 256u; e += 256u) {
            const uint r = e >> 4u;
            const uint c = e & 15u;
            const uint ss = s + r;
            const uint dd = d0 + c;
            sV[r][c] = (ss < pc.T && dd < pc.D) ? v[ss * pc.C + hd + dd] : 0.0;
        }
        barrier();
        for (uint c = 0u; c < 16u; c++) {
            const uint ss = s + c;
            const uint m  = ss - trow + pc.T - 1u;  // relative offset
            const float u = (ss < pc.T && dcol < pc.D) ? used[m * pc.D + dcol] : 0.0;
            acc += sW[ly][c] * (sV[c][lx] + u);
        }
        barrier();
    }
    if (trow < pc.T && dcol < pc.D) {
        out_data[trow * pc.C + hd + dcol] = acc;
    }
}

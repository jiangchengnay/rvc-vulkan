// Attention scores with HEAD-INTERLEAVED Q/K layouts: q, k are [T, C] with
// C = H*D and head h occupying columns [h*D, (h+1)*D). Computes
//   scores[h, t, s] = sum_d q[t, h*D + d] * k[s, h*D + d]
// into out[H, T, T] row-major (index h*T*T + t*T + s).
//
// This folds the "split heads" permutation into the matmul: a generic
// batched matmul would need q/k split into head-major [H, T, D] buffers
// first (two extra permute dispatches + extra buffers); reading the
// interleaved layout directly costs nothing extra at D=64 (each thread
// accumulates over the 64 contiguous floats of its head slice).
//
// One 16x16 workgroup per (h, t-tile, s-tile): gx = ceil(T/16),
// gy = ceil(T/16), gz = H. A/K tiles staged in shared memory (16x128 each,
// 16 KB total; supports head dim D <= 128 — RVC enc_p T5 相对注意力
// hidden=192/heads=2 的 D=96 亦可用；hubert D=64 同 kernel 同累加序
// 数值不变). T up to 16*65535 = 1M within the gy grid limit.
#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer BQ { float q[]; };       // [T, C]
layout(set = 0, binding = 1) readonly buffer BK { float k[]; };       // [T, C]
layout(set = 0, binding = 2) buffer BO { float out_data[]; };         // [H, T, T]

layout(push_constant) uniform PC {
    uint H;
    uint T;
    uint D;   // head dim (<= 128 shared capacity)
    uint C;   // = H * D
} pc;

shared float sQ[16][128];
shared float sK[16][128];

void main() {
    const uint h    = gl_GlobalInvocationID.z;
    const uint t0   = gl_WorkGroupID.y * 16u;
    const uint s0   = gl_WorkGroupID.x * 16u;
    const uint lx   = gl_LocalInvocationID.x;  // col lane
    const uint ly   = gl_LocalInvocationID.y;  // row lane
    const uint tid  = ly * 16u + lx;

    const uint hd = h * pc.D;

    // Stage the q tile (rows t0..t0+15, cols hd..hd+D-1).
    for (uint e = tid; e < 16u * 128u; e += 256u) {
        const uint r = e >> 7u;   // row in tile
        const uint d = e & 127u;  // head-dim col
        const uint tt = t0 + r;
        sQ[r][d] = (tt < pc.T && d < pc.D) ? q[tt * pc.C + hd + d] : 0.0;
    }
    // Stage the k tile (rows s0..s0+15).
    for (uint e = tid; e < 16u * 128u; e += 256u) {
        const uint r = e >> 7u;
        const uint d = e & 127u;
        const uint ss = s0 + r;
        sK[r][d] = (ss < pc.T && d < pc.D) ? k[ss * pc.C + hd + d] : 0.0;
    }
    barrier();

    const uint tt = t0 + ly;
    const uint ss = s0 + lx;
    if (tt < pc.T && ss < pc.T) {
        float acc = 0.0;
        for (uint d = 0u; d < pc.D; d++) acc += sQ[ly][d] * sK[lx][d];
        out_data[h * pc.T * pc.T + tt * pc.T + ss] = acc;
    }
}
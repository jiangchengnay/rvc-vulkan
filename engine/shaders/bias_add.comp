// Row-broadcast bias add: out[i,j] = a[i,j] + b[j], for a/out [rows, cols]
// and b [cols]. Flat 1D dispatch over n = rows*cols; the column index is
// recovered as i % cols (b is indexed per column).
//
// Used to add Linear-layer biases to matmul outputs entirely on the GPU
// (the alternative would be a numpy round-trip per layer). gid.x-only
// indexing (AMD Radeon Pro VII lane0 workaround).
#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer BA { float a[]; };   // [rows, cols]
layout(set = 0, binding = 1) readonly buffer BB { float b[]; };   // [cols]
layout(set = 0, binding = 2) buffer BO { float out_data[]; };     // [rows, cols]

layout(push_constant) uniform PC {
    uint n;     // rows * cols
    uint cols;
} pc;

void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    out_data[i] = a[i] + b[i % pc.cols];
}

// Activation forward — one shader, two modes:
//   mode 0: sigmoid  a[i] = 1 / (1 + exp(-clip(x, -50, 50)))
//   mode 1: tanh     a[i] = tanh(x)
// sigmoid / tanh 前向（标准语义）。
// 输入 x 只读、输出 a 就地/独立；逐元素一线程，grid gx=ceilDiv(n,256)。
#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer BX { float x[]; };
layout(set = 0, binding = 1) buffer BO { float o[]; };

layout(push_constant) uniform PC {
    uint n;
    uint mode;
} pc;

void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    const float v = x[i];
    if (pc.mode == 0u) {
        const float c = clamp(v, -50.0, 50.0);
        o[i] = 1.0 / (1.0 + exp(-c));
    } else {
        o[i] = tanh(v);
    }
}

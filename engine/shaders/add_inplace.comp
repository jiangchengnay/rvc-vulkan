// In-place elementwise add: a[i] += b[i].
// Flat 1D indexing (AMD Radeon Pro VII gid.x-only workaround).
// P1 throughput: float4-vectorised main path (elementwise, result-identical).
#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) buffer BA { float a[]; };
layout(set = 0, binding = 1) readonly buffer BB { float b[]; };

layout(push_constant) uniform PC {
    uint N;
} pc;

void main() {
    const uint gid = gl_GlobalInvocationID.x;
    const uint i4 = gid * 4u;
    if (i4 + 3u < pc.N) {
        vec4 va = vec4(a[i4], a[i4 + 1u], a[i4 + 2u], a[i4 + 3u]);
        vec4 vb = vec4(b[i4], b[i4 + 1u], b[i4 + 2u], b[i4 + 3u]);
        va += vb;
        a[i4] = va.x;
        a[i4 + 1u] = va.y;
        a[i4 + 2u] = va.z;
        a[i4 + 3u] = va.w;
        return;
    }
    for (uint i = i4; i < pc.N && i < i4 + 4u; i++) {
        a[i] += b[i];
    }
}
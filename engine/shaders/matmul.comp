// Tiled matrix multiply template: C[M,N] = A[M,K] x B[K,N], row-major
// (numpy semantics). Stamped into three SPIR-V modules by glslc
// `-D RVC_TILE=<n>` (16|32|64):
//   RVC_TILE=16: 16x16 output tile, 256 threads, 1 output per thread
//   RVC_TILE=32: 32x32 output tile, 256 threads, 2x2 per thread
//   RVC_TILE=64: 64x64 output tile, 256 threads, 4x4 per thread
// The host picks TILE per shape: small matrices need many small
// workgroups, big matrices need deep register blocking (fewer shared
// memory round-trips). Compile-time constants let glslc fully unroll
// the inner loops — runtime bounds/division measured ~5x slower.
//
// AMD Radeon Pro VII lane0 quirk (documented driver/workaround):
//   `gl_GlobalInvocationID.x*N + lid`-style index arithmetic only lands
//   the lane0 write of every group. The established workaround across
//   this codebase is a FLAT 1D grid index and decoding (row,col) inside
//   the shader — never feeding gid through a multiply with a local id
//   term. Here tile coords come from gl_WorkGroupID.y/x and per-thread
//   offsets from gl_LocalInvocationID only; gl_GlobalInvocationID is
//   never multiplied (validated numerically, err ~1e-7).
//
// Shared memory layout:
//   sA[TILE][17]  — A tile, padded row stride 17 (bank-spread reads).
//   sB[16][TILE]  — B tile (K-block rows x TILE cols), cols consecutive.
// Boundary handling in-shader: rows/cols past M/N read zero and never
// write to C; the K tail reads zero via the load guard.
#version 450

#ifndef RVC_TILE
#error "RVC_TILE must be defined (16|32|64)"
#endif

#define TILE_16 16
#define TILE_32 32
#define TILE_64 64

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer BA { float a[]; }; // M x K
layout(set = 0, binding = 1) readonly buffer BB { float b[]; }; // K x N
layout(set = 0, binding = 2) buffer BC { float c[]; };          // M x N

layout(push_constant) uniform PC {
    uint M;
    uint K;
    uint N;
    uint TILE;  // == RVC_TILE; runtime copy kept for the host contract
} pc;

const uint KB = 16u; // K block size

#if RVC_TILE == TILE_16
const uint RPT = 1u;
shared float sA[16][KB + 1u]; // [16][17]
shared float sB[KB][16];      // [16][16]
#elif RVC_TILE == TILE_32
const uint RPT = 2u;
shared float sA[32][KB + 1u]; // [32][17]
shared float sB[KB][32];      // [16][32]
#else
const uint RPT = 4u;
shared float sA[64][KB + 1u]; // [64][17]
shared float sB[KB][64];      // [16][64]
#endif

void main() {
    const uint lx = gl_LocalInvocationID.x; // 0..15, col lane
    const uint ly = gl_LocalInvocationID.y; // 0..15, row lane
    const uint tid = ly * 16u + lx;         // 0..255

    // Workgroup -> TILE x TILE tile (gl_WorkGroupID — never gid*N+lid).
    const uint tr = gl_WorkGroupID.y;       // tile row index
    const uint tc = gl_WorkGroupID.x;       // tile col index
    const uint rowBase = tr * uint(RVC_TILE);
    const uint colBase = tc * uint(RVC_TILE);

#if RVC_TILE == TILE_16
    float acc = 0.0;
#else
    float acc[RPT][RPT];
    for (uint i = 0u; i < RPT; i++)
        for (uint j = 0u; j < RPT; j++)
            acc[i][j] = 0.0;
#endif

    for (uint kt = 0u; kt < pc.K; kt += KB) {
        // ── Load A tile: sA[TILE][16], TILE*16 elems, RPT per thread ──
        // TILE=64 path is float4-vectorised: each thread loads 4
        // consecutive K columns in one 128-bit transaction (the shared
        // tile layout and accumulation order are unchanged, so results
        // are bit-identical to scalar loads). A needs K%4==0 (row stride
        // alignment); B needs N%4==0 (column alignment). Non-vectorisable
        // cases fall back to the scalar loop.
#if RVC_TILE == TILE_64
        const bool k_aligned = (pc.K & 3u) == 0u;
        const bool n_aligned = (pc.N & 3u) == 0u;
        if (k_aligned) {
            // 1024 elems = 256 threads x 4 consecutive columns, one pass.
            const uint e = tid * 4u;       // 0..1020 step 4
            const uint r = e >> 4u;        // row in tile (0..63)
            const uint cc = (e & 15u) & ~3u; // 4-aligned col in block
            const uint row = rowBase + r;
            const uint kk = kt + cc;
            if (row < pc.M && kk + 3u < pc.K) {
                const uint off = row * pc.K + kk;
                vec4 v = vec4(a[off], a[off + 1u], a[off + 2u], a[off + 3u]);
                sA[r][cc] = v.x;
                sA[r][cc + 1u] = v.y;
                sA[r][cc + 2u] = v.z;
                sA[r][cc + 3u] = v.w;
            } else if (row < pc.M && kk < pc.K) {
                for (uint q = 0u; q < 4u; q++) {
                    sA[r][cc + q] = (kk + q < pc.K) ? a[row * pc.K + kk + q] : 0.0;
                }
            } else {
                sA[r][cc] = 0.0;
                sA[r][cc + 1u] = 0.0;
                sA[r][cc + 2u] = 0.0;
                sA[r][cc + 3u] = 0.0;
            }
        } else
#endif
        {
            for (uint t = 0u; t < RPT; t++) {
                const uint e = tid + t * 256u;  // 0..TILE*16-1
                const uint r = e >> 4u;         // row in tile
                const uint cc = e & 15u;        // k col in block
                const uint row = rowBase + r;
                const uint kk = kt + cc;
                sA[r][cc] = (row < pc.M && kk < pc.K) ? a[row * pc.K + kk] : 0.0;
            }
        }
        // ── Load B tile: sB[16][TILE], 16*TILE elems, RPT per thread ──
#if RVC_TILE == TILE_64
        if (n_aligned) {
            const uint e = tid * 4u;       // 0..1020 step 4
            const uint k = e >> 6u;        // k row in block (0..15)
            const uint cc = (e & 63u) & ~3u; // 4-aligned col in tile
            const uint kk = kt + k;
            const uint col = colBase + cc;
            if (kk < pc.K && col + 3u < pc.N) {
                const uint off = kk * pc.N + col;
                vec4 v = vec4(b[off], b[off + 1u], b[off + 2u], b[off + 3u]);
                sB[k][cc] = v.x;
                sB[k][cc + 1u] = v.y;
                sB[k][cc + 2u] = v.z;
                sB[k][cc + 3u] = v.w;
            } else if (kk < pc.K && col < pc.N) {
                for (uint q = 0u; q < 4u; q++) {
                    sB[k][cc + q] = (col + q < pc.N) ? b[kk * pc.N + col + q] : 0.0;
                }
            } else {
                sB[k][cc] = 0.0;
                sB[k][cc + 1u] = 0.0;
                sB[k][cc + 2u] = 0.0;
                sB[k][cc + 3u] = 0.0;
            }
        } else
#endif
        {
            for (uint t = 0u; t < RPT; t++) {
                const uint e = tid + t * 256u;  // 0..16*TILE-1
                const uint k = e / uint(RVC_TILE);   // k row in block (0..15)
                const uint cc = e - k * uint(RVC_TILE); // col in tile
                const uint kk = kt + k;
                const uint col = colBase + cc;
                sB[k][cc] = (kk < pc.K && col < pc.N) ? b[kk * pc.N + col] : 0.0;
            }
        }
        barrier();

        // ── Accumulate: thread's RPT x RPT output block ──
        for (uint kk = 0u; kk < KB; kk++) {
            for (uint i = 0u; i < RPT; i++) {
                const float av = sA[ly * RPT + i][kk];
                for (uint j = 0u; j < RPT; j++) {
#if RVC_TILE == TILE_16
                    acc += av * sB[kk][lx];
#else
                    acc[i][j] += av * sB[kk][lx * RPT + j];
#endif
                }
            }
        }
        barrier(); // protect sA/sB until every lane is done reading
    }

    // ── Write C (WorkGroupID-derived row/col * N — safe index form) ──
#if RVC_TILE == TILE_16
    const uint ro = rowBase + ly;
    const uint co = colBase + lx;
    if (ro < pc.M && co < pc.N) c[ro * pc.N + co] = acc;
#else
    const uint r0 = rowBase + ly * RPT;
    const uint c0 = colBase + lx * RPT;
    for (uint i = 0u; i < RPT; i++) {
        const uint row = r0 + i;
        if (row >= pc.M) break;
        for (uint j = 0u; j < RPT; j++) {
            const uint col = c0 + j;
            if (col >= pc.N) break;
            c[row * pc.N + col] = acc[i][j];
        }
    }
#endif
}
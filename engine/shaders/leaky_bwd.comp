// T-H7: LeakyReLU backward: dst[i] = go[i] * (x[i] >= 0 ? 1.0 : slope)
// One float per thread; grid gx = ceilDiv(n, 256).
#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer BS { float src[]; };  // go
layout(set = 0, binding = 1) readonly buffer BM { float mask[]; }; // x
layout(set = 0, binding = 2) buffer BD { float dst[]; };           // gx

layout(push_constant) uniform PC {
    uint n;
    uint slope_bits;  // f32 bit pattern of the negative slope
} pc;

void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    const float xv = mask[i];
    const float s = uintBitsToFloat(pc.slope_bits);
    dst[i] = src[i] * (xv >= 0.0 ? 1.0 : s);
}